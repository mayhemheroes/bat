# .dockerignore for the commit-image build.
# Goal: bake in the FULL repo (including .git history — the grader uses it),
# dropping only local build artifacts and editor/OS cruft. Dev image, not minimal.
#
# NB: bat's build SCRIPT lives at build/main.rs (Cargo.toml `build = "build/main.rs"`),
# so we must NOT exclude the repo's build/ directory. Only drop cargo/target output.

# ── Build outputs / local cruft ──────────────────────────────────────────────
target/
mayhem/fuzz/target/
**/__pycache__/

# ── Editor / OS noise ────────────────────────────────────────────────────────
.DS_Store
*.swp
*~
